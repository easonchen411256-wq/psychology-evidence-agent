# Psychology Evidence Agent environment template
#
# This file is a reference template. The application does not automatically
# load .env files. Set these variables in the shell or service environment.

# Optional shared password for the local browser API. This is not an LLM API key.
# Use a long random value when the local service is exposed beyond localhost.
PEA_API_KEY=

# Optional directory for local run state and artifacts.
PEA_STORE_ROOT=data

# Optional external search configuration. Explicit --config takes precedence.
PEA_CONFIG=

# Optional model name for the locally installed Codex CLI.
PEA_CODEX_MODEL=gpt-5.5

# Optional contact identifier used only when querying Unpaywall.
UNPAYWALL_EMAIL=

# Test/CI-only escape hatch for environments without a Codex CLI installation.
# Keep this unset or 0 for normal local operation.
PEA_SKIP_CODEX_CHECK=0
